TEMP_DIR=/tmp/security_scans
MAX_REPO_SIZE_MB=500
SCAN_TIMEOUT_SECONDS=600
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Post-fix validation (see docs/CHAIN_ANALYSIS.md)
FIX_MAX_ATTEMPTS=3
# Fix validation history (every attempt) is stored in MongoDB; Validate Fix needs it.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://localhost:27017   (docker run -d -p 27017:27017 mongo:7)
MONGODB_URI=
MONGODB_DATABASE=security_scanner
# Attempts across all Validate Fix runs on one problem
INVESTIGATION_MAX_ATTEMPTS=10
# A predefined fix strategy that failed this often in comparable cases, and never passed, is tried after the LLM
HISTORY_AVOID_AFTER_FAILURES=2
# Opt-in: runs the scanned project's code on this host
VALIDATION_TEST_COMMAND=

