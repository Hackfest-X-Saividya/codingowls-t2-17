{
  "name": "ai-security-scanner",
  "displayName": "AI Security Scanner",
  "description": "Scan your workspace for vulnerable code, dependencies and secrets, and browse every finding in an interactive sidebar.",
  "version": "0.1.3",
  "publisher": "codingowls",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "vulnerabilities",
    "secrets",
    "dependencies"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiSecurity",
          "title": "Security Scanner",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "aiSecurity": [
        {
          "id": "aiSecurity.findings",
          "name": "Findings",
          "icon": "media/shield.svg"
        },
        {
          "id": "aiSecurity.details",
          "name": "Finding Details",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiSecurity.findings",
        "contents": "No scan results yet.\n[$(shield) Scan Workspace](command:aiSecurity.scan)\nScans code (static analysis), dependencies (OSV.dev) and hardcoded secrets.\n[Locate Scanner CLI](command:aiSecurity.locateScanner) · [Settings](command:aiSecurity.openSettings)",
        "when": "!aiSecurity.scanning"
      },
      {
        "view": "aiSecurity.findings",
        "contents": "Scanning workspace…\n[Cancel Scan](command:aiSecurity.cancelScan)",
        "when": "aiSecurity.scanning"
      }
    ],
    "commands": [
      {
        "command": "aiSecurity.scan",
        "title": "Scan Workspace",
        "category": "Security Scanner",
        "icon": "$(debug-start)"
      },
      {
        "command": "aiSecurity.rescan",
        "title": "Re-scan",
        "category": "Security Scanner",
        "icon": "$(refresh)"
      },
      {
        "command": "aiSecurity.scanFolder",
        "title": "Scan Folder with Security Scanner",
        "category": "Security Scanner"
      },
      {
        "command": "aiSecurity.cancelScan",
        "title": "Cancel Scan",
        "category": "Security Scanner",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiSecurity.locateScanner",
        "title": "Locate Scanner CLI (cli.py)…",
        "category": "Security Scanner",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aiSecurity.groupBy",
        "title": "Group By…",
        "category": "Security Scanner",
        "icon": "$(list-tree)"
      },
      {
        "command": "aiSecurity.filter",
        "title": "Filter Findings…",
        "category": "Security Scanner",
        "icon": "$(filter)"
      },
      {
        "command": "aiSecurity.clearFilter",
        "title": "Clear Filter",
        "category": "Security Scanner",
        "icon": "$(filter-filled)"
      },
      {
        "command": "aiSecurity.search",
        "title": "Search Findings…",
        "category": "Security Scanner",
        "icon": "$(search)"
      },
      {
        "command": "aiSecurity.toggleShowIgnored",
        "title": "Show/Hide Ignored Findings",
        "category": "Security Scanner",
        "icon": "$(eye)"
      },
      {
        "command": "aiSecurity.clearResults",
        "title": "Clear Results",
        "category": "Security Scanner",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiSecurity.openSettings",
        "title": "Open Settings",
        "category": "Security Scanner",
        "icon": "$(gear)"
      },
      {
        "command": "aiSecurity.showOutput",
        "title": "Show Scanner Output",
        "category": "Security Scanner",
        "icon": "$(output)"
      },
      {
        "command": "aiSecurity.openFinding",
        "title": "Open Finding",
        "category": "Security Scanner"
      },
      {
        "command": "aiSecurity.revealFinding",
        "title": "Show Finding in Sidebar",
        "category": "Security Scanner"
      },
      {
        "command": "aiSecurity.applyFix",
        "title": "Apply Suggested Fix",
        "category": "Security Scanner",
        "icon": "$(wand)"
      },
      {
        "command": "aiSecurity.showDiff",
        "title": "Show Fix Diff",
        "category": "Security Scanner",
        "icon": "$(diff)"
      },
      {
        "command": "aiSecurity.ignore",
        "title": "Ignore Finding",
        "category": "Security Scanner",
        "icon": "$(eye-closed)"
      },
      {
        "command": "aiSecurity.unignore",
        "title": "Restore Finding",
        "category": "Security Scanner",
        "icon": "$(eye)"
      },
      {
        "command": "aiSecurity.copyDetails",
        "title": "Copy Finding Details",
        "category": "Security Scanner",
        "icon": "$(copy)"
      },
      {
        "command": "aiSecurity.openReference",
        "title": "Open Reference",
        "category": "Security Scanner",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiSecurity.scan",
          "when": "view == aiSecurity.findings && !aiSecurity.scanning",
          "group": "navigation@1"
        },
        {
          "command": "aiSecurity.rescan",
          "when": "view == aiSecurity.findings && aiSecurity.hasResults && !aiSecurity.scanning",
          "group": "navigation@0"
        },
        {
          "command": "aiSecurity.cancelScan",
          "when": "view == aiSecurity.findings && aiSecurity.scanning",
          "group": "navigation@1"
        },
        {
          "command": "aiSecurity.groupBy",
          "when": "view == aiSecurity.findings",
          "group": "navigation@2"
        },
        {
          "command": "aiSecurity.filter",
          "when": "view == aiSecurity.findings && !aiSecurity.hasFilter",
          "group": "navigation@3"
        },
        {
          "command": "aiSecurity.clearFilter",
          "when": "view == aiSecurity.findings && aiSecurity.hasFilter",
          "group": "navigation@3"
        },
        {
          "command": "aiSecurity.search",
          "when": "view == aiSecurity.findings",
          "group": "navigation@4"
        },
        {
          "command": "aiSecurity.toggleShowIgnored",
          "when": "view == aiSecurity.findings",
          "group": "1_view@1"
        },
        {
          "command": "aiSecurity.filter",
          "when": "view == aiSecurity.findings",
          "group": "1_view@2"
        },
        {
          "command": "aiSecurity.clearResults",
          "when": "view == aiSecurity.findings",
          "group": "2_results@1"
        },
        {
          "command": "aiSecurity.showOutput",
          "when": "view == aiSecurity.findings",
          "group": "2_results@2"
        },
        {
          "command": "aiSecurity.openSettings",
          "when": "view == aiSecurity.findings",
          "group": "2_results@3"
        },
        {
          "command": "aiSecurity.locateScanner",
          "when": "view == aiSecurity.findings",
          "group": "2_results@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aiSecurity.applyFix",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bfixable\\b/",
          "group": "inline@1"
        },
        {
          "command": "aiSecurity.ignore",
          "when": "view == aiSecurity.findings && viewItem =~ /^finding/ && !(viewItem =~ /\\bignored\\b/)",
          "group": "inline@2"
        },
        {
          "command": "aiSecurity.unignore",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bignored\\b/",
          "group": "inline@2"
        },
        {
          "command": "aiSecurity.applyFix",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bfixable\\b/",
          "group": "1_fix@1"
        },
        {
          "command": "aiSecurity.showDiff",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bhasfix\\b/",
          "group": "1_fix@2"
        },
        {
          "command": "aiSecurity.copyDetails",
          "when": "view == aiSecurity.findings && viewItem =~ /^finding/",
          "group": "2_info@1"
        },
        {
          "command": "aiSecurity.openReference",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bref\\b/",
          "group": "2_info@2"
        },
        {
          "command": "aiSecurity.ignore",
          "when": "view == aiSecurity.findings && viewItem =~ /^finding/ && !(viewItem =~ /\\bignored\\b/)",
          "group": "3_state@1"
        },
        {
          "command": "aiSecurity.unignore",
          "when": "view == aiSecurity.findings && viewItem =~ /\\bignored\\b/",
          "group": "3_state@1"
        }
      ],
      "explorer/context": [
        {
          "command": "aiSecurity.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "z_security@1"
        }
      ],
      "commandPalette": [
        {
          "command": "aiSecurity.scanFolder",
          "when": "false"
        },
        {
          "command": "aiSecurity.openFinding",
          "when": "false"
        },
        {
          "command": "aiSecurity.applyFix",
          "when": "false"
        },
        {
          "command": "aiSecurity.showDiff",
          "when": "false"
        },
        {
          "command": "aiSecurity.ignore",
          "when": "false"
        },
        {
          "command": "aiSecurity.unignore",
          "when": "false"
        },
        {
          "command": "aiSecurity.copyDetails",
          "when": "false"
        },
        {
          "command": "aiSecurity.openReference",
          "when": "false"
        },
        {
          "command": "aiSecurity.cancelScan",
          "when": "aiSecurity.scanning"
        },
        {
          "command": "aiSecurity.revealFinding",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AI Security Scanner",
      "properties": {
        "aiSecurity.scannerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the scanner CLI (`backend/cli.py`). Leave empty to auto-detect it around the open folder (or reuse the last one that worked). Easiest: run **Security Scanner: Locate Scanner CLI**."
        },
        "aiSecurity.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter with the backend requirements and Semgrep installed. Leave empty to use the `venv` next to `cli.py`, then `python` on PATH."
        },
        "aiSecurity.useAI": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add AI explanations, attack scenarios and code fixes. Needs `GROQ_API_KEY` in `backend/.env`. Turn off for faster scans."
        },
        "aiSecurity.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Re-scan the last scanned folder after a file is saved (debounced)."
        },
        "aiSecurity.scanTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "minimum": 30,
          "description": "Stop a scan that runs longer than this."
        },
        "aiSecurity.minSeverity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "low",
          "description": "Only show squiggles in the editor and Problems panel for findings at or above this severity. The sidebar always lists everything (use its filter instead)."
        },
        "aiSecurity.groupBy": {
          "type": "string",
          "enum": [
            "severity",
            "file",
            "category"
          ],
          "enumDescriptions": [
            "Critical → High → Medium → Low",
            "One group per file",
            "Code, Dependencies, Secrets"
          ],
          "default": "severity",
          "description": "Default grouping in the Findings sidebar."
        },
        "aiSecurity.confirmPackageManager": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before running `npm`/`yarn` to upgrade a vulnerable package (they update `package.json`, the lockfile and `node_modules`)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "aiSecurity",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Internal id of a package upgrade run by the Security Scanner."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "package": "npm run typecheck && node esbuild.js --production && vsce package --skip-license --allow-missing-repository",
    "vscode:prepublish": "node esbuild.js --production",
    "test:integration": "node esbuild.js && tsc -p tsconfig.integration.json && node out/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
